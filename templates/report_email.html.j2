<!DOCTYPE html>
<html>
<head>
<style>
  body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
  h2 { color: #2c3e50; }
  table { border-collapse: collapse; width: 100%; margin-top: 15px; margin-bottom: 15px; }
  th, td { border: 1px solid #ddd; padding: 8px 12px; text-align: left; }
  th { background-color: #f2f2f2; font-weight: bold; }
  .badge-success { background-color: #d4edda; color: #155724; padding: 3px 8px; border-radius: 3px; font-weight: bold; }
  .badge-partial { background-color: #fff3cd; color: #856404; padding: 3px 8px; border-radius: 3px; font-weight: bold; }
  .badge-failed { background-color: #f8d7da; color: #721c24; padding: 3px 8px; border-radius: 3px; font-weight: bold; }
  .badge-skipped { background-color: #e2e3e5; color: #383d41; padding: 3px 8px; border-radius: 3px; font-weight: bold; }
  .summary-card { background: #f8f9fa; border: 1px solid #e9ecef; padding: 15px; border-radius: 5px; margin-bottom: 20px; }
  .error-box { background-color: #fff0f0; border-left: 4px solid #dc3545; padding: 8px; font-family: monospace; font-size: 0.9em; white-space: pre-wrap; }
</style>
</head>
<body>
  <h2>BulkMailer Task Completion Status Report</h2>

  <div class="summary-card">
    <p><strong>Execution Window:</strong> {{ report.start_time.strftime('%Y-%m-%d %H:%M:%S UTC') }} - {{ report.end_time.strftime('%Y-%m-%d %H:%M:%S UTC') }}</p>
    <p><strong>Total Duration:</strong> {{ "%.2f"|format(report.total_duration_ms) }} ms</p>
    <p>
      <strong>Total Tasks:</strong> {{ report.total_tasks }} |
      <span class="badge-success">Success: {{ report.successful_tasks }}</span> |
      <span class="badge-partial">Partial: {{ report.partial_tasks }}</span> |
      <span class="badge-failed">Failed: {{ report.failed_tasks }}</span> |
      <span class="badge-skipped">Skipped: {{ report.skipped_tasks }}</span>
    </p>
  </div>

  <h3>Task Details</h3>
  <table>
    <thead>
      <tr>
        <th>Task ID</th>
        <th>Status</th>
        <th>Sent Count</th>
        <th>Attempts</th>
        <th>Duration (ms)</th>
        <th>Error Details</th>
      </tr>
    </thead>
    <tbody>
      {% for res in report.results %}
      <tr>
        <td><strong>{{ res.task_id }}</strong></td>
        <td>
          {% if res.status == 'SUCCESS' %}
            <span class="badge-success">SUCCESS</span>
          {% elif res.status == 'PARTIAL' %}
            <span class="badge-partial">PARTIAL</span>
          {% elif res.status == 'FAILED' %}
            <span class="badge-failed">FAILED</span>
          {% else %}
            <span class="badge-skipped">SKIPPED</span>
          {% endif %}
        </td>
        <td>{{ res.sent_count }}</td>
        <td>{{ res.attempt_count }}</td>
        <td>{{ "%.2f"|format(res.duration_ms) }}</td>
        <td>
          {% if res.error_details %}
            {% if include_error_trace %}
              <div class="error-box">{{ res.error_details }}</div>
            {% else %}
              <em>Error occurred (details hidden)</em>
            {% endif %}
          {% else %}
            -
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</body>
</html>
